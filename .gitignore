# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

# Logs
*.log
log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (secrets — never commit)
.env
.env.*
!.env.*.example

# OS files
.DS_Store
Thumbs.db

# IDE
/.idea
/.vscode/*
!/.vscode/extensions.json
*.swp
*.swo

# Backend (Laravel)
vendor/
.phpunit.result.cache
.phpactor.json
Homestead.json
Homestead.yaml
auth.json

# Frontend (Node/Vite)
node_modules/
dist/
coverage/
.nyc_output/

# Build outputs
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/plugins
/www
build/
*.exe
*.dmg
/release/
/build/icons/
/squashfs-root/

# OpenCode (agente CLI)
.opencode/
docs/superpowers/

# Claude (agente CLI)
.claude/

# Oxfmtrc
.oxfmtrc.json

# Development artifacts
plan.md
task_plan.md
progress.md

# Session artifacts
cookies.txt

# Brainstorm / Superpowers caches
.superpowers/

# Cache files
front/.eslintcache

# Playwright CLI session artifacts
.playwright-cli/

# Unused test artifacts
back/tests/Feature/Concerns/

# Playwright accessibility snapshots
entry-edit.yaml

# Test artifacts
front/test-results/

# Vite temp files
front/vite.config.ts.timestamp-*
# Local AI runtime state
.atl/
.codegraph/
