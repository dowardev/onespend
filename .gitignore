# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

# Logs
*.log
log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.*.local
.env.production

# IDE
/.idea
/.vscode/*
!/.vscode/extensions.json
*.swp
*.swo

# Backend (Laravel)
vendor/
.env.backup
.env.production
.phpunit.result.cache
.phpactor.json
Homestead.json
Homestead.yaml
auth.json

# Frontend (Node/Vite)
node_modules/
dist/
coverage/
.nyc_output/

# Build outputs
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/plugins
/www
build/
*.exe
*.dmg
/release/
/build/icons/
/squashfs-root/

# OpenCode (agente CLI)
.opencode/

# Oxfmtrc
.oxfmtrc.json
