          "definition": "Profit generated after covering essential period expenses.",
          "formula": "Total income − Cost of Living"
        },
        "operatingSavings": {
          "term": "Operating Savings",
          "definition": "Amount available after non-essential variable expenses.",
          "formula": "Gross Profit − Discretionary Expenses"
        },
        "netResult": {
          "term": "Net Result",
          "definition": "Final period result after all expenses, including financial ones.",
          "formula": "Operating Savings − Financial Expenses"
        },
        "incomes": {
          "term": "Income",
          "definition": "All money coming in during the period: salary, investments, and other income.",
          "formula": "Salary + Investments + Other income"
        },
        "costOfLife": {
          "term": "Cost of Living",
          "definition": "Day-to-day expenses: housing, food, transport, and health.",
          "formula": "Housing + Food + Transport + Health"
        },
        "discretionaryExpenses": {
          "term": "Discretionary Expenses",
          "definition": "Non-essential expenses such as entertainment and other optional spending.",
          "formula": "Entertainment + Other"
        },
        "financialExpenses": {
          "term": "Financial Expenses",
          "definition": "Interest, bank fees, and costs related to debts and loans.",
          "formula": "Sum of all transactions categorized as financial"
        },
