          "term": "Salary",
          "definition": "Income from payroll, wages, or salaries from main work."
        },
        "investments": {
          "term": "Investments",
          "definition": "Returns on investments, dividends, or rental income from properties."
        },
        "otherIncome": {
          "term": "Other income",
          "definition": "Income that does not fit salary or investments."
        },
