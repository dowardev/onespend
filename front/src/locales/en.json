    "contactBody": "If you want to delete your account and all associated data, email us at vortinext@dowar.xyz and we will process the deletion within 30 days."
  },
  "privacyPolicy": {
    "title": "Privacy Policy",
    "lastUpdated": "Last updated: August 24, 2026",
    "intro": "OneSpend (\"the app\") is an expense and budget manager developed by DowarDev (\"we\", \"our\"). This policy explains what information the app handles and how we protect it.",
    "sections": {
      "dataCollected": "1. Information We Collect",
      "dataCollectedAccount": "Account data",
      "dataCollectedAccountBody": "To sync your data across devices, the app uses its own sign-in service. We collect your username and email address.",
      "dataCollectedFinancial": "Financial data you enter",
      "dataCollectedFinancialBody": "Expenses, income, budgets, accounts, vendors, products, and notes that you voluntarily enter in the app.",
      "dataCollectedAttachments": "Attachments",
      "dataCollectedAttachmentsBody": "Images or other files that you attach to your records (for example, product photos).",
      "dataCollectedNot": "We do not collect",
      "dataCollectedNotBody": "location data, contacts, or device information for advertising purposes, nor do we use third-party analytics tools.",
      "storage": "2. How We Store Your Information",
      "storageLocal": "On your device",
      "storageLocalBody": "the app works offline and saves your data locally in your device's storage.",
      "storageServer": "On our servers",
      "storageServerBody": "if you sign in, your data is synced in encrypted form to our servers (dowar.xyz) solely to enable syncing between your own devices and backups.",
      "storageNoSell": "We do not sell or share",
      "storageNoSellBody": "your personal information with third parties for advertising or commercial purposes.",
      "use": "3. Use of Information",
      "useBody": "The information is used exclusively to:",
      "useList": {
        "functionality": "Provide the app's functionality (expense tracking, budgets, statistics)",
        "sync": "Sync your data across your devices",
        "support": "Provide you with support when you request it"
      },
      "retention": "4. Data Retention and Deletion",
      "retentionBody1": "You can delete your local data by deleting the records within the app or by uninstalling the app.",
      "retentionBody2": "To delete your account and all data stored on our servers, contact us at {email} and we will process the deletion within a maximum of 30 days.",
      "security": "5. Security",
      "securityBody": "Communication between the app and our servers uses TLS encryption. Access to the servers is restricted, and data is stored in encrypted form.",
      "minors": "6. Minors",
      "minorsBody": "The app is not directed at children under 13, and we do not knowingly collect information from them.",
      "changes": "7. Changes to this policy",
      "changesBody": "We may update this policy from time to time. Changes will be posted on this page with a new update date.",
      "contact": "8. Contact",
      "contactBody": "If you have questions about this policy or want to exercise your rights over your data (access, rectification, deletion):",
      "contactInfo": "{company} — {email}",
      "source": "Source code: {url}"
    }
  },
