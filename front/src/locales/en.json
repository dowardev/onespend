      "glossary": {
        "grossProfit": {
          "term": "Gross Profit",
          "definition": "Profit generated after covering essential period expenses.",
          "formula": "Total income − Cost of living"
        },
        "operatingSavings": {
          "term": "Operating Savings",
          "definition": "Amount available after non-essential variable expenses.",
          "formula": "Gross Profit − Discretionary Expenses"
        },
        "netResult": {
          "term": "Net Result",
          "definition": "Final period result after all expenses, including financial ones.",
          "formula": "Operating Savings − Financial Expenses"
        },
        "incomes": {
          "term": "Income",
          "definition": "All money coming in during the period: salary, investments, and other income.",
          "formula": "Salary + Investments + Other income"
        },
        "costOfLife": {
          "term": "Cost of Living",
          "definition": "Day-to-day expenses: housing, food, transport, and health.",
          "formula": "Housing + Food + Transport + Health"
        },
        "discretionaryExpenses": {
          "term": "Discretionary Expenses",
          "definition": "Non-essential expenses such as entertainment and other optional spending.",
          "formula": "Entertainment + Other"
        },
        "financialExpenses": {
          "term": "Financial Expenses",
          "definition": "Interest, bank fees, and costs related to debts and loans.",
          "formula": "Sum of all transactions categorized as financial"
        },
        "salary": {
          "term": "Salary",
          "definition": "Income from payroll, wages, or salaries from main work."
        },
        "investments": {
          "term": "Investments",
          "definition": "Returns on investments, dividends, or rental income from properties."
        },
        "otherIncome": {
          "term": "Other income",
          "definition": "Income that does not fit salary or investments."
        },
        "housing": {
          "term": "Housing",
          "definition": "Rent, mortgage, and home or apartment maintenance expenses."
        },
        "food": {
          "term": "Food",
          "definition": "Expenses at the supermarket, pantry, restaurants, and food in general."
        },
        "transport": {
          "term": "Transport",
          "definition": "Gasoline, Uber, taxi, bus, public transport, and related expenses."
        },
        "health": {
          "term": "Health",
          "definition": "Doctor visits, medications, health insurance, and pharmacy."
        },
        "entertainment": {
          "term": "Entertainment",
          "definition": "Cinema, Netflix, Spotify, games, and any leisure spending."
        },
        "interestAndFees": {
          "term": "Interest and fees",
          "definition": "Credit card interest, bank fees, and financial costs."
        },
        "other": {
          "term": "Other",
          "definition": "Expenses or income that do not fit any of the categories above."
        }
      }
    }
