{
  "name": "OneSpend",
  "private": true,
  "version": "0.57.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "start": "ionic s",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,json,css,scss,md}\"",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"vite\" \"wait-on tcp:5173 && ELECTRON_START_URL=http://localhost:5173 electron ./electron/main.mjs\"",
    "electron:attach": "wait-on tcp:5173 && ELECTRON_START_URL=http://localhost:5173 electron ./electron/main.mjs",
    "electron:attach-ionic": "wait-on tcp:8100 && ELECTRON_START_URL=http://localhost:8100 electron ./electron/main.mjs",
    "electron:dev-ionic": "concurrently -k -n IONIC,ELECTRON -c blue,green \"ionic s\" \"pnpm run electron:attach-ionic\"",
    "icons": "node scripts/generate-icons.mjs",
    "electron:build": "pnpm run icons && pnpm run build && pnpm exec electron-builder",
    "build:linux": "pnpm run icons && pnpm run build && pnpm exec electron-builder --linux --x64 --publish never",
    "build:win": "pnpm run icons && pnpm run build && pnpm exec electron-builder --win --x64 --publish never",
    "build:mac": "pnpm run icons && pnpm run build && pnpm exec electron-builder --mac --x64 --publish never",
    "build:all": "pnpm run icons && pnpm run build && pnpm exec electron-builder --linux --win --mac --x64 --publish never",
    "electron:build-rpm": "node electron/build-rpm.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.0.1",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.0.1",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/status-bar": "8.0.0",
    "@fsouza/prettierd": "^0.26.2",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "chart.js": "^4.4.0",
    "date-fns": "^4.1.0",
    "eslint_d": "^14.3.0",
    "html2canvas": "^1.4.1",
    "ionicons": "^7.0.0",
    "jspdf": "^4.0.0",
    "pinia": "^2.0.34",
    "vue": "^3.3.0",
    "vue-chartjs": "^5.1.1",
    "vue-router": "^4.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.0.1",
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-legacy": "^5.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/test-utils": "^2.3.0",
    "asar": "^3.2.0",
    "concurrently": "^9.1.2",
    "cypress": "^13.5.0",
    "electron": "^33.2.0",
    "electron-builder": "24.13.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^9.0.0",
    "jsdom": "^22.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "terser": "^5.4.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.46.3",
    "vite": "~5.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^0.34.6",
    "vue-tsc": "^2.1.10",
    "wait-on": "^8.0.2"
  },
  "overrides": {
    "rollup": "4.44.0"
  },
  "description": "An Ionic project",
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.dowardev.abogaz",
    "productName": "OneSpend",
    "executableName": "abogaz",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "rpm"
      ],
      "category": "Utility",
      "icon": "build/icons"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "author": {
    "name": "DowarDev",
    "email": "gonzalo@dowar.xyz"
  },
  "homepage": "https://dowar.xyz"
}
